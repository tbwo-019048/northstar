# Supabase (client / publishable values only — safe to ship to the browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_key

# App access gate — shared secret entered on the login screen before the
# Supabase email/password form is unlocked. Change this to your own value.
VITE_APP_ACCESS_TOKEN=change-me

# NEVER put the Supabase secret / service_role key in this file or any VITE_ var.
# It would be bundled into the browser build. Keep it server-side only.
